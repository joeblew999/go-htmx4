// The Worker on Cloudflare: its name, bindings, variables and domain. wrangler dev runs it locally, wrangler deploy
// ships it (workers-go: https://github.com/syumai/workers-go).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-htmx4",
  "main": "worker/index.mjs",
  // Not newer than the workerd wrangler brings (package-lock.json).
  "compatibility_date": "2026-09-11",
  "build": { "command": "npm run build" },
  // Vite's output, served before the Worker runs.
  "assets": { "directory": "dist" },
  "dev": { "port": 8913 },
  // The board: D1 is the source of truth. A new migration is a new idempotent file in migrations/.
  "d1_databases": [{ "binding": "DB", "database_name": "go-htmx4", "database_id": "TODO", "migrations_dir": "migrations" }],
  // One Room per topic fans the board out over hibernated WebSockets (worker/room.mjs).
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Every write handler calls s.limited first: 60 writes per 10 s per IP.
  "ratelimits": [{ "name": "WRITES", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } }],
  // What wrangler dev runs with. Each environment below states its own: wrangler inherits none of these keys.
  "vars": { "APP_ENV": "wrangler dev (local)", "NOMINATIM_URL": "https://nominatim.openstreetmap.org" },
  "observability": { "enabled": true },
  "env": {
    // npm run deploy: the Worker go-htmx4 on its domain.
    "production": {
      "name": "go-htmx4",
      "routes": [{ "pattern": "go-htmx4.ubuntusoftware.net", "custom_domain": true }],
      "vars": { "APP_ENV": "cloudflare", "APP_DOMAIN": "go-htmx4.ubuntusoftware.net", "NOMINATIM_URL": "https://nominatim.openstreetmap.org" },
      "d1_databases": [{ "binding": "DB", "database_name": "go-htmx4", "database_id": "TODO", "migrations_dir": "migrations" }],
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [{ "name": "WRITES", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } }]
    },
    // Exactly what is on main: its own Worker and D1, no domain, not indexed (APP_PREVIEW).
    "staging": {
      "name": "go-htmx4-staging",
      "vars": { "APP_ENV": "staging", "APP_PREVIEW": "1", "NOMINATIM_URL": "https://nominatim.openstreetmap.org" },
      "d1_databases": [{ "binding": "DB", "database_name": "go-htmx4-staging", "database_id": "TODO", "migrations_dir": "migrations" }],
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [{ "name": "WRITES", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } }]
    }
  }
}
